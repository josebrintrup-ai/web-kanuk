.trust{max-width:1320px;margin:0 auto;padding:0 36px 20px;display:grid;grid-template-columns:repeat(4,1fr);gap:14px} .trust div{background:#fff;border:1px solid var(--border);border-radius:18px;padding:18px;display:flex;gap:12px}
