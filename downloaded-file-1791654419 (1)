.products{max-width:1320px;margin:0 auto;padding:90px 36px} .sec{text-align:center;margin-bottom:40px} .sec h3{font-size:48px;color:var(--green);letter-spacing:-1px} .sec p{color:#888;margin-top:10px}
.filters{display:flex;justify-content:center;gap:10px;margin-bottom:36px;flex-wrap:wrap} .fbtn{border:1px solid var(--border);background:#fff;padding:10px 20px;border-radius:100px;font-weight:700;font-size:13px;cursor:pointer;transition:.2s} .fbtn.active{background:var(--green);color:#fff;border-color:var(--green)}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px} .card{background:#fff;border:1px solid var(--border);border-radius:26px;overflow:hidden;display:flex;flex-direction:column;transition:.35s} .card:hover{transform:translateY(-8px);box-shadow:0 20px 50px rgba(0,0,0,.1)}
.card-img{height:340px;display:flex;align-items:center;justify-content:center;padding:20px;position:relative;background:linear-gradient(180deg,var(--cream),#fff)} .card-img img{max-width:100%;max-height:100%;object-fit:contain;filter:drop-shadow(0 12px 24px rgba(0,0,0,.18))} .tag{position:absolute;top:16px;left:16px;color:#fff;font-size:10px;font-weight:800;padding:6px 12px;border-radius:8px;letter-spacing:.6px}
.card-body{padding:22px;flex:1;display:flex;flex-direction:column} .card-body h4{font-size:19px;color:var(--green)} .card-body small{font-size:11px;color:#999;letter-spacing:.7px;text-transform:uppercase;margin:6px 0 12px;display:block} .card-body p{font-size:13.5px;color:#666;line-height:1.55;flex:1} .ing{background:var(--sand);border:1px dashed var(--border);border-radius:12px;padding:10px 12px;font-size:11.5px;margin:14px 0;color:#555}
.foot{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--border);padding-top:16px;margin-top:14px} .price{font-size:22px;font-weight:900;color:var(--green)} .add{background:var(--green);color:#fff;border:none;padding:11px 18px;border-radius:12px;font-weight:800;cursor:pointer;transition:.2s} .add:hover{background:var(--green2)}
.drawer{position:fixed;top:0;right:-460px;width:440px;height:100%;background:#fff;z-index:400;box-shadow:-20px 0 80px rgba(0,0,0,.2);transition:.4s cubic-bezier(.2,.8,.2,1);display:flex;flex-direction:column} .drawer.open{right:0} .overlay{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:300;display:none} .overlay.on{display:block}
.cart-h{padding:22px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center} .cart-b{padding:22px;flex:1;overflow:auto} .ship{background:var(--cream);border:1px solid var(--border);padding:14px;border-radius:14px;text-align:center;font-size:13px;margin-bottom:18px;font-weight:600} .item{display:flex;gap:14px;margin-bottom:16px;border-bottom:1px solid #f0f0f0;padding-bottom:14px} .item img{width:64px;height:64px;object-fit:contain;background:var(--sand);border-radius:12px} .qty{display:flex;gap:10px;align-items:center;margin-top:8px} .qbtn{width:28px;height:28px;border:1px solid var(--border);background:#fff;border-radius:8px;cursor:pointer;font-weight:700}
.cart-f{padding:22px;border-top:1px solid var(--border);background:var(--sand)} .checkout{width:100%;background:var(--green);color:#fff;border:none;padding:18px;border-radius:16px;font-weight:900;cursor:pointer;font-size:16px;margin-bottom:12px} .qrbox{background:#fff;border:1px solid var(--border);border-radius:16px;padding:16px;text-align:center;margin-top:12px} .qrbox img{width:160px;height:160px;border-radius:12px;display:block;margin:0 auto 10px}
.proceso{max-width:1320px;margin:60px auto;padding:0 36px;display:grid;grid-template-columns:repeat(3,1fr);gap:20px} .proc{background:#fff;border:1px solid var(--border);border-radius:20px;padding:26px} .proc b{color:var(--green);font-size:13px;display:block;margin-bottom:8px} .proc p{font-size:13px;color:#666;line-height:1.5}
footer{background:var(--cream);border-top:1px solid var(--border);padding:56px 36px;text-align:center;color:#888;font-size:12px;line-height:1.7;margin-top:80px} footer img.reverso{max-width:920px;width:100%;border-radius:20px;border:1px solid var(--border);margin-top:24px}
@media(max-width:900px){.hero{grid-template-columns:1fr}.grid{grid-template-columns:1fr 1fr}.trust{grid-template-columns:1fr 1fr}.proceso{grid-template-columns:1fr}.drawer{width:100%;right:-100%}}
@media(max-width:600px){.grid{grid-template-columns:1fr}.hero h2{font-size:42px} .nav{display:none} header{padding:14px 18px}}
</style>
</head>
<body>
