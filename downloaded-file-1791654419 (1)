<style>
:root{--sand:#fbf9f4;--green:#1b4332;--green2:#2d6a4f;--border:#e8e0c8;--cream:#f4f0e6;}
*{box-sizing:border-box;margin:0;padding:0}body{font-family:'Inter',sans-serif;background:var(--sand);color:#111}
h1,h2,h3,h4{font-family:'Fraunces',serif} 
.topbar{background:var(--green);color:#fff;text-align:center;padding:10px;font-size:11px;letter-spacing:1px;font-weight:600}
header{position:sticky;top:0;z-index:100;backdrop-filter:blur(20px);background:rgba(251,249,244,.92);border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;padding:18px 36px}
