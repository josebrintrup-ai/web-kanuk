.ctas{display:flex;gap:14px;margin-bottom:28px} .btn-p{background:var(--green);color:#fff;border:none;padding:16px 28px;border-radius:100px;font-weight:800;cursor:pointer;font-size:15px} .btn-g{background:#fff;border:1px solid var(--border);padding:16px 28px;border-radius:100px;font-weight:700;cursor:pointer}
