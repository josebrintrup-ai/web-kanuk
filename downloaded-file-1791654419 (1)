<script>
const PRODUCTS=[{
id:'traquea_crunchies',name:'TRÁQUEA CRUNCHIES',sub:'Tiras de tráquea de equino',cat:'entrenamiento',price:7990,ing:`Tráquea de equino (100%)`,desc:`Tiras crujientes que se quiebran fácil. Cartílago natural ideal para premiar sin exigir mordida.`,color:'#0f2f4d',protein:'78%',img:'data:image/png;base64,'
},
{
id:'bocados_nordic',name:'BOCADOS NORDIC HEST',sub:'Tiras de pulmón de equino',cat:'entrenamiento',price:7990,ing:`Pulmón de equino (100%)`,desc:`Livianos, aroma intenso, se parten con los dedos. Perfectos para cachorros y entrenamiento.`,color:'#1a6a7a',protein:'82%',img:'data:image/png;base64,'
},
{
id:'jerky_nordic',name:'JERKY NORDIC HEST',sub:'Tiras de carne de cabeza',cat:'premio',price:7990,ing:`Carne de cabeza de equino (100%)`,desc:`Proteína magra deshidratada, tiras flexibles y ultra palatables. El premio ancestral.`,color:'#5a2327',protein:'76%',img:'data:image/png;base64,'
},
{
id:'fibras_nordic',name:'FIBRAS NORDIC HEST',sub:'Tiras de esófago de equino',cat:'masticado',price:7990,ing:`Esófago de equino (100%)`,desc:`Tiras fibrosas y resistentes que obligan a masticar de verdad y limpian dientes.`,color:'#1b4332',protein:'80%',img:'data:image/png;base64,'
},
{
id:'baston_nordic',name:'BASTÓN NORDIC HEST',sub:'Masticable 100% equino',cat:'masticado',price:8490,ing:`Equino (100%) pieza entera`,desc:`Masticable largo, denso y satisfactorio. Para perros que aman morder.`,color:'#2b2b33',protein:'75%',img:'data:image/png;base64,'
},
{
id:'galletas_kanuk',name:'GALLETAS KANUK',sub:'Carne de equino y zapallo',cat:'premio',price:5990,ing:`Carne equino, zapallo. 44% proteína`,desc:`Galleta dura tamaño premio, ideal para dar en mano. Con zapallo natural.`,color:'#c9a86a',protein:'44%',img:'data:image/png;base64,'
}];
let cart=[];
function render(f='all'){
 const g=document.getElementById('grid'); g.innerHTML='';
 PRODUCTS.filter(p=>f==='all'||p.cat===f).forEach(p=>{
  g.innerHTML+=`<div class="card"><div class="card-img" style="background:linear-gradient(180deg,#f4f0e6,#fff)"><span class="tag" style="background:${p.color}">${p.protein} PROTEÍNA</span><img src="${p.img}"></div><div class="card-body"><h4>${p.name}</h4><small>${p.sub} · 150g</small><p>${p.desc}</p><div class="ing"><b>INGREDIENTES:</b> ${p.ing} · <b>MODO USO:</b> Dar como complemento. Agua fresca.</div><div class="foot"><div class="price">$${p.price.toLocaleString('es-CL')}</div><button class="add" onclick="add('${p.id}')">Agregar</button></div></div></div>`;
 });
}
function add(id){let p=PRODUCTS.find(x=>x.id===id);let e=cart.find(x=>x.id===id);if(e)e.qty++;else cart.push({...p,qty:1});upd();toggleCart(true);}
function upd(){document.getElementById('ccount').innerText=cart.reduce((s,i)=>s+i.qty,0);let cont=document.getElementById('citems');if(!cart.length){cont.innerHTML='<div style="text-align:center;margin-top:40px;color:#999">Tu carro está vacío</div>';document.getElementById('subtotal').innerText='$0';document.getElementById('ship').innerText='¡Agrega $25.000 para envío gratis!';return;}let tot=cart.reduce((s,i)=>s+i.price*i.qty,0);let h='';cart.forEach(i=>{h+=`<div class="item"><img src="${i.img}"><div style="flex:1"><b style="font-size:13px">${i.name}</b><div style="font-size:11px;color:#888">${i.sub}</div><div class="qty"><button class="qbtn" onclick="chg('${i.id}',-1)">-</button><span>${i.qty}</span><button class="qbtn" onclick="chg('${i.id}',1)">+</button></div></div><b>$${(i.price*i.qty).toLocaleString('es-CL')}</b></div>`;});cont.innerHTML=h;document.getElementById('subtotal').innerText='$'+tot.toLocaleString('es-CL');let rem=25000-tot;document.getElementById('ship').innerText=rem>0?`¡Te faltan $${rem.toLocaleString('es-CL')} para envío gratis!`:`🎉 ¡Tienes envío gratis en RM!`;}
function chg(id,d){let e=cart.find(x=>x.id===id);if(!e)return;e.qty+=d;if(e.qty<=0)cart=cart.filter(x=>x.id!==id);upd();}
function toggleCart(f){let dr=document.getElementById('drawer'),ov=document.getElementById('overlay');let open=f===true?true:!dr.classList.contains('open');if(open){dr.classList.add('open');ov.classList.add('on');}else{dr.classList.remove('open');ov.classList.remove('on');}}
function filterProd(c,b){document.querySelectorAll('.fbtn').forEach(x=>x.classList.remove('active'));b.classList.add('active');render(c);}
function checkout(){if(!cart.length){alert('Tu carro está vacío');return;}let tot=cart.reduce((s,i)=>s+i.price*i.qty,0);alert('Total $'+tot.toLocaleString('es-CL')+'\n\nAhora el cliente puede escanear el QR de Mercado Pago que está en el carrito para pagar al instante.\n\nTambién puedes copiar este link de pago y mandarlo por WhatsApp.');}
render();
</script>
